// Tabelas do Better Auth (P2). Os models são minúsculos de propósito: o adapter
// Prisma do Better Auth resolve os nomes assim (`user`, `session`, `account`,
// `verification`) — e `advanced.database.generateId: "uuid"` no auth.ts faz a
// lib gerar UUIDs para honrar a convenção de PK do repo. Colunas em snake_case
// via @map, tabelas plurais via @@map, como o resto do schema.

model user {
  id            String    @id @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  // Soft delete (P12): conta "excluída" é marcada, não apagada — preserva
  // auditoria por 7 dias antes da purga real. A lib não conhece a coluna;
  // ela é escrita apenas pelo fluxo de exclusão de conta.
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  accounts Account[]

  characters            Character[] @relation("OwnedCharacters") // dono de fichas (PJ e NPC completo)
  npcTemplates          NpcTemplate[] @relation("OwnedNpcTemplates") // dono de modelos de NPC
  masteredRooms         Room[] @relation("MasteredRooms") // salas que criou
  roomMemberships       RoomMember[] @relation("RoomMemberships")
  activeRoomCharacters  RoomCharacter[] @relation("ActiveRoomCharacters") // PJ ativo em cada sala
  responsibleParticipants InitiativeParticipant[] @relation("ResponsibleParticipants")
  notifications         Notification[] @relation("Notifications")
  auditRolls            AuditRoll[] @relation("AuditRolls") // sobrevive como NULL se o user sair
  auditLogs             AuditLog[] @relation("AuditLogs")

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}
