# Template de variáveis de ambiente. Copie para `.env.local` e ajuste:
#   cp .env.example .env.local

# --- Banco de dados (Prisma) -----------------------------------------------
# String de conexão do PostgreSQL usada pelo Prisma (schema em prisma/schema/).
#
# Fluxo Docker (recomendado): a app roda no container e fala com o serviço
# `postgres` do docker-compose.dev.yml — use o host `postgres`.
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/app_dev?schema=public"
#
# Rodando a app no host (Modo B, `yarn dev` local): troque o host para localhost,
# já que a porta 5432 do Postgres é publicada:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev?schema=public"

# --- OpenTelemetry (observabilidade) ---------------------------------------
# Em produção, a infra (ansible) injeta estas variáveis no container da app.
# Localmente, sem um OTel Collector rodando, mantenha o SDK desligado.

# Desliga o SDK do OpenTelemetry. Deixe `true` em dev local (sem collector).
OTEL_SDK_DISABLED=true

# Endpoint do OTel Collector (sidecar no mesmo pod). Injetado pela infra em prod.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Nome do serviço reportado nas métricas (ex.: project-name). Injetado pela infra.
# OTEL_SERVICE_NAME=app

# --- Object storage (S3-compatível) -----------------------------------------
# Em dev, o serviço `storage` do docker-compose.dev.yml (SeaweedFS) serve a API
# S3 em :9003 (não :9000 — porta já usada pelo SonarQube local). Ver
# docs/adr/0009-object-storage-seaweedfs.md para o porquê.
#
# Credenciais e bucket abaixo batem com docker/storage/s3.json e o bucket
# criado pelo serviço `storage-setup` — mude os dois lados juntos se alterar.
S3_ENDPOINT="http://localhost:9003"
S3_BUCKET="app-bucket"
S3_ACCESS_KEY="app"
S3_SECRET_KEY="app123456"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE=true
#
# Em produção, substitua pelo endpoint/credenciais do S3 gerenciado da infra.
# S3_PUBLIC_URL=https://your-domain.com/storage

# --- Aplicação ---------------------------------------------------------------
# URL pública da aplicação, usada para gerar robots.txt e sitemap.xml.
# Em produção, injete via variável de ambiente da infra.
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- Auth (Better Auth) --------------------------------------------------------
# Segredo de assinatura de sessão — gere com: openssl rand -hex 32
BETTER_AUTH_SECRET="troque-por-um-segredo-de-32-caracteres-ou-mais"
BETTER_AUTH_URL="http://localhost:3000"

# Discord OAuth (opcional): sem as duas variáveis, o login fica só por
# e-mail/senha e o botão do Discord some. Crie o app em
# https://discord.com/developers/applications com redirect
# {BETTER_AUTH_URL}/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
